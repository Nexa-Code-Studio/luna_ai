# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# Infrastructure Connections (Local development default; use docker service names like @postgres:5432 when running inside Docker)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/luna_ai
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# AI Providers Configuration (Placeholders)
LLM_PROVIDER=openai
LLM_API_KEY=your-llm-api-key-here

STT_PROVIDER=whisper
STT_API_KEY=your-stt-api-key-here

TTS_PROVIDER=elevenlabs
TTS_API_KEY=your-tts-api-key-here
