# Application Environment & URLs
APP_ENV=development
LOG_LEVEL=INFO
PORT=8888
MCP_PORT=8889
API_BASE_URL=http://localhost:8888/api/v1
WS_BASE_URL=ws://localhost:8888


# Infrastructure Connections (Local development default; use docker service names like @luna_postgres:5432 when running inside Docker)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/luna_ai
REDIS_URL=redis://localhost:6380/0
QDRANT_URL=http://localhost:6333

# AI Providers Configuration (Placeholders)
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
DEEPSEEK_MODEL=deepseek-chat
LLM_API_KEY=your-llm-api-key-here


STT_PROVIDER=whisper
STT_API_KEY=your-stt-api-key-here

TTS_PROVIDER=elevenlabs
TTS_API_KEY=your-tts-api-key-here
EDGE_TTS_VOICE=id-ID-GadisNeural


